DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=True

# Postgres (recommended). If unset, Django falls back to SQLite.
# DATABASE_URL=postgres://appuser:applongpassword@127.0.0.1:5432/appdb

# ---------------------------------------------------------------------------
# Redis (optional for local; required for shared cache + Celery workers)
# ---------------------------------------------------------------------------
# Single host with logical DB separation (cache=0, broker=1).
# ALWAYS set a password. Prefer bind=127.0.0.1 in redis.conf (admin on Windows).
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/0
#
# Or explicit URLs (preferred in production):
# REDIS_CACHE_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/1
#
# Result backend is optional — leave unset unless you need task result storage:
# CELERY_RESULT_BACKEND=
#
# TLS example (managed Redis):
# REDIS_CACHE_URL=rediss://:PASSWORD@redis.internal:6380/0
# CELERY_BROKER_URL=rediss://:PASSWORD@redis.internal:6380/1

# Dashboard summary soft-cache (seconds). Defaults ON only when Redis cache is configured.
# DASHBOARD_SUMMARY_CACHE_ENABLED=True
# DASHBOARD_SUMMARY_CACHE_TTL=30

# Per-request Django NDJSON timing middleware (off by default).
# PERF_DEBUG_MIDDLEWARE=False

# Production hardening
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
